#!/usr/bin/python3 -I
"""dvarapala (द्वारपाल, "permission"): run commands with the user's approval. For AI agents.

Instead of asking the user to copy sudo commands into a terminal, an agent
sends the commands and the reason for each. An approval window shows them on
the desktop; the user ticks the ones to allow (and types their password once
if any runs as root); the window closes at once and the ticked commands run;
the agent waits, and gets every command's output and exit code back as JSON.

Each command says how it runs, and the window marks the two apart:
  "as": "root"   (the default) as root, from /; needs the user's password
  "as": "user"   as the user, outside the agent's sandbox, in "cwd" (an
                 absolute path; default: home); approved with a click.
                 For anything the agent can't run itself.

Usage (any agent that can run a shell command):

    dvarapala <<'EOF'
    {"requester": "Claude Code",
     "reason": "Install and start the Docker daemon you asked for.",
     "commands": [
       {"cmd": "pacman -S --needed --noconfirm docker", "why": "Install Docker"},
       {"cmd": "systemctl enable --now docker.socket", "why": "Start it on demand"},
       {"cmd": "docker compose up -d", "why": "Start the project's services",
        "as": "user", "cwd": "/home/me/project"}
     ]}
    EOF

    dvarapala --why "Reload udev rules" --cmd "udevadm control --reload"   # one-off form
    dvarapala --as user --cwd ~/project --why "Push the branch" --cmd "git push"
    dvarapala --schema     # request/result format (JSON Schema)
    dvarapala --mcp        # MCP server on stdio (tool: request_commands)
    dvarapala --serve      # one MCP server for every agent, on a socket
                           # (dvarapala-mcp.socket; --mcp reaches it through pranali)

A secret you need (an API token, a password) is asked for the same way, never
in the chat: the user types it into the window and it's saved to the file you
name (0600, as the user, before any command runs). You only learn whether it
was saved; read it from the file.

    dvarapala <<'EOF'
    {"requester": "Claude Code", "reason": "Point the tools' sites at your domain.",
     "secrets": [{"path": "~/.config/cloudflare/token", "what": "Cloudflare DNS token",
                  "why": "Edit DNS for theyashsawarkar.dev (My Profile, API Tokens)"}]}
    EOF
    dvarapala --secret ~/.config/cloudflare/token --what "Cloudflare DNS token" \
              --why "Edit DNS for your domain"                                  # one-off form

Exit codes: 0 everything approved and succeeded; 1 an approved command
failed (or a secret couldn't be saved); 3 nothing ran (denied, timed out,
wrong password); 4 some commands or secrets were declined, the rest
succeeded; 2 bad request or tool error.

Commands run with `bash -c`, with no stdin and no tty, in request order,
stopping at the first failure: use non-interactive flags (pacman
--noconfirm, apt -y). The user can decline any
of them, so check "results" for each command's "state". Docs:
https://github.com/Theyashsawarkar/dvarapala
"""
import argparse
import json
import os
import re
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
import uuid

DIALOG = "/usr/local/lib/dvarapala/dialog.py"
LIB = "/usr/local/lib/dvarapala"
VERSION = "1.8.0"

MAX_COMMANDS, MAX_CMD, MAX_WHY, MAX_REASON, MAX_REQUESTER, MAX_CWD = 50, 8000, 500, 2000, 80, 1024
MAX_SECRETS, MAX_WHAT, MAX_PATH = 5, 80, 1024
AS = ("root", "user")
# Characters that can make displayed text differ from what runs: C0/C1
# controls (except tab/newline), bidi overrides and isolates, zero-width.
HIDDEN = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f​-‏‪-‮⁠-⁩﻿]")

SCHEMA = {
    "request": {
        "type": "object",
        "description": "At least one command or one secret.",
        "properties": {
            "requester": {"type": "string", "maxLength": MAX_REQUESTER,
                          "description": "Who is asking, shown to the user (e.g. 'Claude Code')."},
            "reason": {"type": "string", "maxLength": MAX_REASON,
                       "description": "Why these commands are needed, in plain words."},
            "commands": {"type": "array", "minItems": 1, "maxItems": MAX_COMMANDS, "items": {
                "type": "object", "required": ["cmd", "why"],
                "properties": {
                    "cmd": {"type": "string", "maxLength": MAX_CMD,
                            "description": "Run with bash -c, no stdin."},
                    "why": {"type": "string", "maxLength": MAX_WHY,
                            "description": "What this command does and why, one line."},
                    "as": {"enum": list(AS), "default": "root",
                           "description": "'root' (from /, needs the user's password) or 'user' (as the "
                                          "user, outside your sandbox, approved with a click)."},
                    "cwd": {"type": "string", "maxLength": MAX_CWD,
                            "description": "With as 'user' only: the absolute directory to run in "
                                           "(default: the user's home). Root commands always run from /."}}}},
            "secrets": {"type": "array", "minItems": 1, "maxItems": MAX_SECRETS, "items": {
                "type": "object", "required": ["path", "what", "why"],
                "description": "A secret (token, password) the user types into the window. It is saved to "
                               "'path' (0600) as the user, before any command runs; you never see it, only "
                               "whether it was saved. Read it from that file in your commands.",
                "properties": {
                    "path": {"type": "string", "maxLength": MAX_PATH,
                             "description": "Where to save it: an absolute path in the user's home (~ is "
                                            "allowed), outside any git repository, e.g. "
                                            "~/.config/cloudflare/token."},
                    "what": {"type": "string", "maxLength": MAX_WHAT,
                             "description": "What it is, as the user knows it: 'Cloudflare DNS token'."},
                    "why": {"type": "string", "maxLength": MAX_WHY,
                            "description": "What it's for and where to get it, one line."}}}},
        },
    },
    "result": {
        "type": "object",
        "properties": {
            "status": {"enum": ["completed", "denied", "timeout", "auth_failed", "error"]},
            "message": {"type": "string"},
            "approved": {"type": "array", "items": {"type": "integer"}},
            "declined": {"type": "array", "items": {"type": "integer"}},
            "secrets": {"type": "array", "items": {"type": "object", "properties": {
                "index": {"type": "integer"}, "path": {"type": "string"}, "what": {"type": "string"},
                "state": {"enum": ["saved", "declined", "failed", "not_run"]},
                "error": {"type": "string"}}}},
            "results": {"type": "array", "items": {"type": "object", "properties": {
                "index": {"type": "integer"}, "command": {"type": "string"}, "why": {"type": "string"},
                "as": {"enum": list(AS)}, "cwd": {"type": "string"},
                "decision": {"enum": ["approved", "declined"]},
                "state": {"enum": ["ok", "failed", "skipped", "declined", "not_run"]},
                "exit_code": {"type": "integer"}, "stdout": {"type": "string"},
                "stderr": {"type": "string"}, "duration": {"type": "number"},
                "timed_out": {"type": "boolean"}, "truncated": {"type": "boolean"}}}},
        },
    },
}


class BadRequest(Exception):
    pass


def validate(req):
    if not isinstance(req, dict):
        raise BadRequest("the request must be a JSON object")
    cmds = req.get("commands", [])
    secrets = req.get("secrets", [])
    if not isinstance(cmds, list) or not isinstance(secrets, list):
        raise BadRequest("'commands' and 'secrets' must be lists")
    if not cmds and not secrets:
        raise BadRequest("send at least one command, or one secret to ask for")
    if len(cmds) > MAX_COMMANDS:
        raise BadRequest(f"at most {MAX_COMMANDS} commands per request")
    clean = []
    for i, c in enumerate(cmds):
        if not isinstance(c, dict) or not isinstance(c.get("cmd"), str) or not c["cmd"].strip():
            raise BadRequest(f"commands[{i}] needs a non-empty 'cmd' string")
        if not isinstance(c.get("why"), str) or not c["why"].strip():
            raise BadRequest(f"commands[{i}] needs a 'why': the user decides from it")
        if len(c["cmd"]) > MAX_CMD or len(c["why"]) > MAX_WHY:
            raise BadRequest(f"commands[{i}] is too long (cmd {MAX_CMD}, why {MAX_WHY} chars)")
        for field in ("cmd", "why"):
            if HIDDEN.search(c[field]):
                raise BadRequest(f"commands[{i}].{field} contains control or invisible characters")
        who = c.get("as", "root")
        if who not in AS:
            raise BadRequest(f"commands[{i}].as must be 'root' or 'user'")
        item = {"cmd": c["cmd"], "why": c["why"].strip(), "as": who}
        cwd = c.get("cwd")
        if cwd is not None:
            if who == "root":
                raise BadRequest(f"commands[{i}]: root commands always run from /, drop 'cwd'")
            if not isinstance(cwd, str) or not cwd.startswith("/") or len(cwd) > MAX_CWD:
                raise BadRequest(f"commands[{i}].cwd must be an absolute path")
            if HIDDEN.search(cwd):
                raise BadRequest(f"commands[{i}].cwd contains control or invisible characters")
            item["cwd"] = os.path.normpath(cwd)
        clean.append(item)
    out = {"commands": clean, "secrets": validate_secrets(secrets)}
    for field, limit in (("requester", MAX_REQUESTER), ("reason", MAX_REASON)):
        v = req.get(field, "")
        if not isinstance(v, str) or len(v) > limit:
            raise BadRequest(f"'{field}' must be a string of at most {limit} chars")
        if HIDDEN.search(v.replace("\n", " ")):
            raise BadRequest(f"'{field}' contains control or invisible characters")
        out[field] = v.strip()
    return out


def validate_secrets(secrets):
    if len(secrets) > MAX_SECRETS:
        raise BadRequest(f"at most {MAX_SECRETS} secrets per request")
    home = os.path.expanduser("~")
    clean, seen = [], set()
    for i, s in enumerate(secrets):
        if not isinstance(s, dict):
            raise BadRequest(f"secrets[{i}] must be an object")
        for field, limit in (("path", MAX_PATH), ("what", MAX_WHAT), ("why", MAX_WHY)):
            v = s.get(field)
            if not isinstance(v, str) or not v.strip():
                raise BadRequest(f"secrets[{i}] needs a '{field}'")
            if len(v) > limit:
                raise BadRequest(f"secrets[{i}].{field} is too long ({limit} chars)")
            if HIDDEN.search(v):
                raise BadRequest(f"secrets[{i}].{field} contains control or invisible characters")
        raw = s["path"].strip()
        path = os.path.normpath(home + raw[1:] if raw == "~" or raw.startswith("~/") else raw)
        if not os.path.isabs(path):
            raise BadRequest(f"secrets[{i}].path must be absolute (or start with ~/)")
        if not path.startswith(home + os.sep):
            raise BadRequest(f"secrets[{i}].path must be inside your home")
        if path in seen:
            raise BadRequest(f"secrets[{i}].path is asked for twice")
        seen.add(path)
        clean.append({"path": path, "what": s["what"].strip(), "why": s["why"].strip()})
    return clean


def session_env(wayland=None):
    """The graphical session the dialog must appear on: the agent's display
    (its environment, or its pranali hello's) when it's one of this user's,
    else the first one found."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if wayland and not os.path.exists(os.path.join(runtime, wayland)):
        wayland = None   # another session's (a nested test): not one shown here
    wayland = wayland or os.environ.get("WAYLAND_DISPLAY")
    if not wayland:
        socks = sorted(f for f in os.listdir(runtime) if re.fullmatch(r"wayland-\d+", f)) if os.path.isdir(runtime) else []
        wayland = socks[0] if socks else None
    if not wayland:
        raise BadRequest("no Wayland session found: the approval window needs the user's desktop")
    env = {"WAYLAND_DISPLAY": wayland, "XDG_RUNTIME_DIR": runtime,
           "HOME": os.path.expanduser("~"), "LANG": os.environ.get("LANG", "C.UTF-8"),
           # Root-owned, so user GTK CSS/settings can't restyle (or hide) the dialog.
           "XDG_CONFIG_HOME": f"{LIB}/config", "XDG_DATA_HOME": f"{LIB}/data",
           "XDG_DATA_DIRS": "/usr/local/share:/usr/share",
           "XDG_CACHE_HOME": os.path.join(runtime, "dvarapala", "cache"),
           "PATH": "/usr/local/bin:/usr/bin"}
    bus = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime}/bus"
    env["DBUS_SESSION_BUS_ADDRESS"] = bus
    return env


def request(req, wayland=None):
    """Show the approval window for a validated request; return the result."""
    if not os.path.exists(DIALOG):
        raise BadRequest(f"{DIALOG} is missing: run ~/dotfiles/ai/apply.sh")
    env = session_env(wayland)
    rid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:8]
    base = os.path.join(env["XDG_RUNTIME_DIR"], "dvarapala")
    os.makedirs(base, mode=0o700, exist_ok=True)
    os.makedirs(env["XDG_CACHE_HOME"], mode=0o700, exist_ok=True)
    rdir = os.path.join(base, rid)
    os.mkdir(rdir, 0o700)
    with open(os.path.join(rdir, "request.json"), "w") as f:
        json.dump({"id": rid, **req}, f)
    unit = f"dvarapala-{rid}"
    # A transient user service: the dialog isn't a child of this process
    # (or of the agent), and env -i drops anything the caller set.
    cmd = ["systemd-run", "--user", "--quiet", "--collect", f"--unit={unit}",
           "--", "/usr/bin/env", "-i", *(f"{k}={v}" for k, v in env.items()),
           "/usr/bin/python3", "-I", DIALOG, rdir]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        raise BadRequest(f"couldn't start the approval window: {p.stderr.strip()}")
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "dvarapala", "-u", "critical", "-i", "security-high",
                        "Root access requested" if any(c["as"] == "root" for c in req["commands"])
                        else "A secret requested" if not req["commands"] else "Approval requested",
                        f"{req.get('requester') or 'An AI agent'} {wants(req)}."],
                       capture_output=True)
    # The window enforces the 10-minute expiry itself (it writes a
    # "timeout" result), so wait for a result or for the window to exit.
    result_path = os.path.join(rdir, "result.json")
    try:
        while True:
            if os.path.exists(result_path):
                with open(result_path) as f:
                    return json.load(f)
            if subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit]).returncode != 0:
                time.sleep(0.5)  # the result may land just as the unit stops
                if os.path.exists(result_path):
                    continue
                return {"id": rid, "status": "error", "results": [],
                        "message": f"the approval window exited without a result (journalctl --user -u {unit})"}
            time.sleep(0.25)
    finally:
        shutil.rmtree(rdir, ignore_errors=True)


def wants(req):
    """'wants to run 2 commands as root', 'asks you for your Cloudflare token', or both."""
    parts = []
    if req["commands"]:
        parts.append(f"wants to run {summary(req['commands'])}")
    if req.get("secrets"):
        names = [s["what"] for s in req["secrets"]]
        parts.append("asks you for " + (names[0] if len(names) == 1 else f"{len(names)} secrets"))
    return " and ".join(parts)


def summary(commands):
    """'2 commands as root and 1 as you' (the window says the same)."""
    root = sum(c["as"] == "root" for c in commands)
    user = len(commands) - root
    first = root or user
    text = f"{first} command{'s' * (first != 1)} as {'root' if root else 'you'}"
    return text + (f" and {user} as you" if root and user else "")


def exit_code(result):
    st = result.get("status")
    if st != "completed":
        return 2 if st == "error" else 3
    states = [r.get("state") for r in result.get("results", [])]
    kept = [s.get("state") for s in result.get("secrets", [])]
    if "failed" in states or "failed" in kept:
        return 1
    if "declined" in states or "declined" in kept:
        return 4
    return 0


# ---------------------------------------------------------------- MCP ----
MCP_TOOL = {
    "name": "request_commands",
    "title": "Run commands as root or as the user (with the user's approval)",
    "description": (
        "Ask the user to approve shell commands you can't run yourself. Each command has 'as': 'root' "
        "(the default; runs as root from /, needs the user's password) or 'user' (runs as the user, "
        "outside your sandbox, in 'cwd', default home; approved with a click, no password). An approval "
        "window shows every command with your 'why', marked root or user; the user ticks which to allow. "
        "The approved ones run in order with bash -c and no stdin (use non-interactive flags like "
        "--noconfirm), stopping at the first failure. Returns each command's decision, state, exit code "
        "and output. Blocks until the user answers (up to 10 minutes) and the approved commands finish; "
        "the window closes as soon as the user answers, so tell them what happened. The user may decline some or all "
        "commands: check each result's 'state'. Never use this to work around a refusal or a permission "
        "rule the user set. "
        "For a secret you need (an API token, a password), never ask the user to paste it into the chat: "
        "send it in 'secrets' with where to save it; the user types it into the window, it's saved to that "
        "file (0600) before your commands run, and you only learn whether it was saved."),
    "inputSchema": SCHEMA["request"],
}
# The 1.x name, kept so existing setups work: the same tool.
MCP_TOOLS = [MCP_TOOL, {**MCP_TOOL, "name": "request_root_commands",
                        "title": "Run commands as root (old name of request_commands)"}]


class Session:
    """One agent's MCP session: lines in, JSON-RPC objects out through
    write(). On stdio (`--mcp --in-process`) or one connection to the shared
    server (`--serve`); each tool call runs in its own thread, as before."""

    def __init__(self, write, wayland=None, server=None):
        self.write, self.wayland, self.server = write, wayland, server
        self.lock = threading.Lock()
        self.busy = threading.Condition()
        self.calls = 0

    def send(self, obj):
        with self.lock:
            try:
                self.write(json.dumps(obj) + "\n")
            except (OSError, ValueError):
                pass   # the agent went away; the window and the commands carry on

    def call(self, msg_id, args):
        try:
            res = request(validate(args or {}), wayland=self.wayland)
            self.send({"jsonrpc": "2.0", "id": msg_id, "result": {
                "content": [{"type": "text", "text": json.dumps(res, indent=2)}],
                "structuredContent": res,
                "isError": res.get("status") != "completed"}})
        except BadRequest as e:
            self.send({"jsonrpc": "2.0", "id": msg_id, "result": {
                "content": [{"type": "text", "text": f"Bad request: {e}"}], "isError": True}})
        except Exception as e:  # keep the server alive whatever happens
            self.send({"jsonrpc": "2.0", "id": msg_id, "error": {"code": -32603, "message": str(e)}})
        finally:
            with self.busy:
                self.calls -= 1
                self.busy.notify_all()
            if self.server is not None:
                self.server.finished()

    def wait(self, seconds):
        """Waits up to `seconds` for this session's calls to finish."""
        end = time.monotonic() + seconds
        with self.busy:
            while self.calls and time.monotonic() < end:
                self.busy.wait(end - time.monotonic())

    def handle(self, line):
        send = self.send
        try:
            msg = json.loads(line)
        except ValueError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
            return
        if not isinstance(msg, dict):
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "invalid request"}})
            return
        method, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:
            return  # notifications (initialized, cancelled) need no answer
        if method == "initialize":
            client = (msg.get("params") or {}).get("protocolVersion") or "2025-06-18"
            send({"jsonrpc": "2.0", "id": msg_id, "result": {
                "protocolVersion": client,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": "dvarapala", "version": VERSION},
                "instructions": "Use request_commands for anything that needs root on this machine "
                                "(as 'root'), or that you can't run yourself (as 'user'), instead of "
                                "asking the user to paste commands into a terminal."}})
        elif method == "ping":
            send({"jsonrpc": "2.0", "id": msg_id, "result": {}})
        elif method == "tools/list":
            send({"jsonrpc": "2.0", "id": msg_id, "result": {"tools": MCP_TOOLS}})
        elif method == "tools/call":
            params = msg.get("params") or {}
            if params.get("name") not in {t["name"] for t in MCP_TOOLS}:
                send({"jsonrpc": "2.0", "id": msg_id,
                      "error": {"code": -32602, "message": f"unknown tool {params.get('name')!r}"}})
                return
            if self.server is not None and not self.server.started():
                # stopping: refused before anything was shown, so a retry is safe
                send({"jsonrpc": "2.0", "id": msg_id, "error": {
                    "code": -32002, "message": "dvarapala is restarting; this call was not run, retry it"}})
                return
            with self.busy:
                self.calls += 1
            threading.Thread(target=self.call, args=(msg_id, params.get("arguments")), daemon=True).start()
        else:
            send({"jsonrpc": "2.0", "id": msg_id, "error": {"code": -32601, "message": f"no method {method}"}})


def mcp_serve():
    """MCP on stdio, in this process (one per agent session)."""
    def write(text):
        sys.stdout.write(text)
        sys.stdout.flush()
    session = Session(write)
    for line in sys.stdin:
        session.handle(line)
    return 0


# ------------------------------------------------- one server for every agent
# pranali (github.com/Theyashsawarkar/pranali) carries each agent's MCP from
# its stdio to this socket, so every session shares one server instead of a
# Python process each. Nothing about what runs changes: requests are
# validated and shown exactly as before, by the same window, and each
# carries its own requester. The socket is 0600 in a 0700 directory of the
# user's, and only the user's own processes (SO_PEERCRED) are served: the
# same ones that can already run `dvarapala` (ADR 12).
HELLO_MAX, HELLO_WAIT, OWED_WAIT, DRAIN_WAIT = 64 * 1024, 5, 10, 20


def socket_path():
    """Where pranali looks for it (its PROTOCOL.md): $PRANALI_SOCKET, else
    $XDG_RUNTIME_DIR/dvarapala/mcp.sock, else under the state directory."""
    if os.environ.get("PRANALI_SOCKET"):
        return os.environ["PRANALI_SOCKET"]
    if os.environ.get("XDG_RUNTIME_DIR"):
        return os.path.join(os.environ["XDG_RUNTIME_DIR"], "dvarapala", "mcp.sock")
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(state, "dvarapala", "run", "mcp.sock")


def private_dir(path):
    """The socket's directory, made 0700 if missing; refused unless it's a
    directory of this user's that nobody else can enter."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise SystemExit(f"dvarapala: {path} must be a directory of yours with mode 0700")


class Server:
    def __init__(self):
        self.stopping = False
        self.lock = threading.Condition()
        self.calls = 0

    def started(self):
        """A call begins, unless the server is stopping."""
        with self.lock:
            if self.stopping:
                return False
            self.calls += 1
            return True

    def finished(self):
        with self.lock:
            self.calls -= 1
            self.lock.notify_all()

    def drain(self, seconds):
        """Stops taking calls; waits up to `seconds` for those running."""
        end = time.monotonic() + seconds
        with self.lock:
            self.stopping = True
            while self.calls and time.monotonic() < end:
                self.lock.wait(end - time.monotonic())
            return self.calls

    def serve(self, conn):
        try:
            _pid, uid, _gid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if uid != os.getuid():
                return   # (the socket's 0600 already keeps others out)
            conn.settimeout(HELLO_WAIT)
            f = conn.makefile("rb")
            line = f.readline(HELLO_MAX)
            try:
                hello = json.loads(line)
            except ValueError:
                hello = None
            if not isinstance(hello, dict) or hello.get("pranali") != 1:
                conn.sendall(b'{"pranali":1,"ok":false,"error":"expected a pranali hello"}\n')
                return
            env = hello.get("env") if isinstance(hello.get("env"), dict) else {}
            wayland = env.get("WAYLAND_DISPLAY")
            if not isinstance(wayland, str) or len(wayland) > 255 or HIDDEN.search(wayland) or "/" in wayland:
                wayland = None
            conn.sendall(b'{"pranali":1,"ok":true}\n')
            conn.settimeout(None)

            def write(text):
                conn.sendall(text.encode())
            session = Session(write, wayland=wayland, server=self)
            while True:
                line = f.readline()
                if not line:
                    break
                session.handle(line.decode("utf-8", "replace"))
            # the agent's side closed (half-close): answers owed still go out, for a while
            session.wait(OWED_WAIT)
        except OSError:
            pass
        finally:
            try:
                conn.close()
            except OSError:
                pass


class Stop(Exception):
    pass


def listener():
    """The socket systemd passes (dvarapala-mcp.socket), or one bound here."""
    if os.environ.get("LISTEN_PID") == str(os.getpid()) and int(os.environ.get("LISTEN_FDS") or 0) >= 1:
        for k in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
            os.environ.pop(k, None)
        sock = socket.socket(fileno=3)
        sock.set_inheritable(False)
        return sock, None
    path = socket_path()
    if len(path.encode()) > 107:
        raise SystemExit(f"dvarapala: socket path too long: {path}")
    private_dir(os.path.dirname(path))
    if os.path.lexists(path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(path)
            raise SystemExit(f"dvarapala: a server already answers on {path}")
        except (ConnectionRefusedError, FileNotFoundError):
            os.unlink(path)   # a dead server's: nobody answers it
        finally:
            probe.close()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old = os.umask(0o177)
    try:
        sock.bind(path)
    finally:
        os.umask(old)
    os.chmod(path, 0o600)
    sock.listen(64)
    return sock, (path, os.stat(path).st_ino)


def serve():
    """`--serve`: one MCP server for every agent session (through pranali).
    Idle, it sleeps in accept(): no timers, no wakeups. On SIGTERM it takes
    no new calls (they're answered -32002, safe to retry) and lets running
    ones finish for up to 20 s (the unit's TimeoutStopSec is 30)."""
    sock, bound = listener()
    server = Server()

    def stop(*_):
        raise Stop()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        while True:
            conn, _ = sock.accept()
            threading.Thread(target=server.serve, args=(conn,), daemon=True).start()
    except Stop:
        pass
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        sock.close()
        if bound:   # only a socket we bound ourselves, and still ours
            try:
                if os.stat(bound[0]).st_ino == bound[1]:
                    os.unlink(bound[0])
            except OSError:
                pass
    left = server.drain(DRAIN_WAIT)
    if left:
        print(f"dvarapala: stopped with {left} request(s) still waiting for an answer; their windows "
              "stay open and run what you approve, but the agents won't hear the result", file=sys.stderr)
    return 0


def mcp_entry(in_process):
    """`--mcp`: through pranali to the shared server when pranali is on
    PATH (it runs this in-process server instead when there's no server to
    reach), else this process serves MCP itself."""
    pranali = None if in_process else shutil.which("pranali")
    if pranali:
        me = os.path.realpath(sys.argv[0])
        try:
            os.execv(pranali, [pranali, "dvarapala", "--fallback",
                               sys.executable, "-I", me, "--mcp", "--in-process"])
        except OSError as e:
            print(f"dvarapala: can't run pranali ({e}); serving MCP here", file=sys.stderr)
    return mcp_serve()


def main():
    ap = argparse.ArgumentParser(prog="dvarapala", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--file", help="read the JSON request from this file (default: stdin)")
    ap.add_argument("--cmd", action="append", default=[], help="a command (pair each with --why)")
    ap.add_argument("--why", action="append", default=[], help="why the matching --cmd is needed")
    ap.add_argument("--reason", default="", help="overall reason (with --cmd)")
    ap.add_argument("--as", dest="as_", choices=AS, default="root",
                    help="with --cmd: run them as root (default) or as the user")
    ap.add_argument("--cwd", help="with --cmd --as user: the directory to run in (default: home)")
    ap.add_argument("--requester", default=None, help="who is asking (shown to the user)")
    ap.add_argument("--secret", metavar="PATH", help="ask the user for a secret, saved to PATH (0600)")
    ap.add_argument("--what", help="with --secret: what it is ('Cloudflare DNS token')")
    ap.add_argument("--schema", action="store_true", help="print the request/result JSON Schema")
    ap.add_argument("--mcp", action="store_true", help="serve MCP on stdio (through pranali when it's there)")
    ap.add_argument("--in-process", action="store_true", help="with --mcp: serve MCP in this process")
    ap.add_argument("--serve", action="store_true",
                    help="one MCP server for every agent, on $XDG_RUNTIME_DIR/dvarapala/mcp.sock")
    ap.add_argument("--version", action="version", version=VERSION)
    a = ap.parse_args()
    if a.schema:
        print(json.dumps(SCHEMA, indent=2))
        return 0
    if a.serve:
        return serve()
    if a.mcp:
        return mcp_entry(a.in_process)
    try:
        if a.secret:
            if a.cmd:
                raise BadRequest("--secret and --cmd go in separate requests (or send JSON with both)")
            if not a.what or len(a.why) != 1:
                raise BadRequest("--secret needs --what and one --why")
            raw = {"reason": a.reason, "secrets": [{"path": a.secret, "what": a.what, "why": a.why[0]}]}
        elif a.cmd:
            if len(a.cmd) != len(a.why):
                raise BadRequest("give one --why for every --cmd")
            extra = {"as": a.as_}
            if a.cwd is not None:
                extra["cwd"] = os.path.abspath(a.cwd)
            raw = {"reason": a.reason, "commands": [{"cmd": c, "why": w, **extra} for c, w in zip(a.cmd, a.why)]}
        else:
            if not a.file and sys.stdin.isatty():
                ap.print_help()
                return 2
            text = open(a.file).read() if a.file else sys.stdin.read()
            try:
                raw = json.loads(text)
            except ValueError as e:
                raise BadRequest(f"not valid JSON: {e}")
        if a.requester is not None and isinstance(raw, dict):
            raw["requester"] = a.requester
        result = request(validate(raw))
    except BadRequest as e:
        result = {"status": "error", "message": str(e), "results": []}
    print(json.dumps(result, indent=2))
    return exit_code(result)


if __name__ == "__main__":
    sys.exit(main())
